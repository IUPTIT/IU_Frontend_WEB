# IU Club Frontend — copy thành .env
# URL API backend (kèm prefix /api/v1)
VITE_API_URL=http://localhost:3456/api/v1

# URL public của website (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://iuptit.com

# Cổng dev server (npm run dev) — mặc định 5173
DEV_PORT=5173
# Cổng preview/production (npm run start) — mặc định 4173
# Lưu ý: KHÔNG dùng 6666/6000/6665-6669/10080 — trình duyệt chặn (ERR_UNSAFE_PORT)
WEB_PORT=4173
